{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Izin default aplikasi PotongAudio — hanya sidecar FFmpeg/FFprobe dan dialog native, tidak ada akses shell/filesystem umum.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:allow-open",
    "dialog:allow-save",

    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/ffmpeg", "sidecar": true },
        { "name": "binaries/ffprobe", "sidecar": true }
      ]
    }
  ]
}
