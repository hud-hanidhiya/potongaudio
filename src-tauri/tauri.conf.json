{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PotongAudio",
  "version": "0.1.0",
  "identifier": "com.potongaudio.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "features": ["tauri-runtime"],
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "PotongAudio",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  },

  "plugins": {
    "fs": {
      "scope": [{ "path": "**" }]
    }
  }
}
